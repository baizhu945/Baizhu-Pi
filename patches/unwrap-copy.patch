+export const WRAP_MARKER = "\x1b_Pwrap\x1b\\";
+export const WRAP_SPACE_MARKER = "\x1b_PwrapS\x1b\\";
+
+/**
+ * Classify the wrap marker a rendered line ends with:
+ *  - "space": the source text continues on the next row with whitespace
+ *  - "none":  the source text continues without whitespace
+ *  - undefined: no wrap marker (a real newline boundary)
+ * Trailing padding / background reset sequences after the marker are ignored.
+ */
+export function wrapBoundaryKind(line: string): "space" | "none" | undefined {
+	const check = (marker: string): boolean => {
+		const idx = line.indexOf(marker);
+		return idx !== -1 && stripTerminalSequences(line.slice(idx + marker.length)).trim() === "";
+	};
