+/** Text component that horizontally centers each rendered line. */
+class CenteredText extends Text {
+	private centeredWidth = 0;
+	private centeredLines: string[] = [];
+
+	override render(width: number): string[] {
+		if (this.centeredLines.length > 0 && this.centeredWidth === width) {
+			return this.centeredLines;
+		}
+		// Text.render() pads every line to width, so center the wrapped lines
+		// before padding them to the full terminal width.
+		const text = (this as unknown as { text: string }).text;
+		const wrapped = wrapTextWithAnsi(text, width);
+		let maxWidth = 0;
+		for (const line of wrapped) {
+			maxWidth = Math.max(maxWidth, visibleWidth(line));
+		}
+		const lead = maxWidth >= width ? 0 : Math.floor((width - maxWidth) / 2);
+		this.centeredWidth = width;
+		this.centeredLines = wrapped.map((line) => {
+			const lineWidth = visibleWidth(line);
+			return " ".repeat(lead) + line + " ".repeat(Math.max(0, width - lead - lineWidth));
+		});
+		return this.centeredLines.length > 0 ? this.centeredLines : [" ".repeat(width)];
+	}
+}
