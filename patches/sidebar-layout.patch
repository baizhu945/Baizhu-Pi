+/**
+ * Text component that horizontally centers each rendered line.
+ * Used for the big startup logo.
+ */
+class CenteredText extends Text {
+	private centeredWidth = 0;
+	private centeredLines: string[] = [];
+
+	override render(width: number): string[] {
+		if (this.centeredLines.length > 0 && this.centeredWidth === width) {
+			return this.centeredLines;
+		}
+		// Text.render() pads every line to `width`, which would defeat centering
+		// (visibleWidth(line) === width). Wrap + center manually instead.
+		// Centering uses the WIDEST line as the block anchor so rows of unequal
+		// width (the official logo has 6- and 8-char rows) stay left-aligned and
+		// the whole block centers as one unit (no sideways drift between rows).
+		const text = (this as unknown as { text: string }).text;
+		const wrapped = wrapTextWithAnsi(text, width);
+		let maxW = 0;
+		for (const line of wrapped) {
+			const w = visibleWidth(line);
+			if (w > maxW) maxW = w;
+		}
+		const blockLead = maxW >= width ? 0 : Math.max(0, Math.floor((width - maxW) / 2));
+		const lines = wrapped.map((line) => {
+			const w = visibleWidth(line);
+			if (w >= width) return line;
+			return " ".repeat(blockLead) + line + " ".repeat(Math.max(0, width - blockLead - w));
+		});
+		this.centeredWidth = width;
+		this.centeredLines = lines.length > 0 ? lines : [" ".repeat(width)];
+		return this.centeredLines;
+	}
+}
