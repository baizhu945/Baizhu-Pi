+	private handleMainScreenMouseInput(data: string): TuiInputListenerResult {
+		if (data === FOCUS_IN || data === FOCUS_OUT) {
+			if (data === FOCUS_OUT) this.clearMainSelection();
+			return { consume: true };
+		}
+		if (!this.enableScroll) return undefined;
+		if (this.hasOverlayEntries) return undefined; // overlays: don't intercept clicks
+		const event = this.parseSgrMouseEvent(data);
+		if (!event) return undefined; // wheel or other sequence: let TuiBase handle it
+		if (event.button === 64 || event.button === 65) return undefined; // wheel: TuiBase scrolls
+		if ((event.button & 3) !== 0) return undefined; // middle/right button: not selection
+		this.handleMainSelectionMouseEvent(event);
+		return { consume: true };
+	}
+
+	private parseSgrMouseEvent(data: string): { button: number; x: number; y: number; release: boolean } | undefined {
