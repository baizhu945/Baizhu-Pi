+		const col = Math.max(0, Math.min(mainW - 1, Math.max(0, Math.min(width - 1, event.x))));
+		const maxRow = Math.max(0, this.selectionSourceLines.length - 1);
+		const row = Math.max(0, Math.min(maxRow, this.windowStartRow + Math.max(0, Math.min(height - 1, event.y))));
