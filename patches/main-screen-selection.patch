+		let start = 0;
+		for (const segment of wordSegmenter.segment(line)) {
+			const end = start + visibleWidth(segment.segment);
+			if (point.col >= start && point.col < end) {
+				return { start: { ...point, col: start }, end: { ...point, col: end, boundary: true } };
+			}
+			start = end;
+		}
+		return undefined;
+	}
