+		if (!match) return undefined;
+		return {
+			button: Number.parseInt(match[1], 10),
+			x: Number.parseInt(match[2], 10) - 1,
+			y: Number.parseInt(match[3], 10) - 1,
+			release: match[4] === "m",
+		};
+	}
